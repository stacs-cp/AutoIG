given g_n_bots: int(1..10)

letting shelf_l be 5
letting shelf_w be 2

letting corridor_size be 2
letting world_border be 10

given g_n_shelves_across: int(1..50)
given g_n_shelves_down: int(1..50)

letting X be (g_n_shelves_across * (shelf_l + corridor_size) + (world_border * 2)) $ contains extra "corridor" space
letting Y be (g_n_shelves_down * (self_w + corridor_size) + (g_y_edge_size * 2))  $ contains extra "corridor" space

letting map_size be X * Y

letting row_id be map_size / X
letting column_id be map_size % X

find bots: int(1..10)

find n_shelves_across: int(1..50)
find n_shelves_down: int(1..50)

find bot_start: matrix indexed by [int(1..n_bots)] of int(1..map_size)
find bot_end: matrix indexed by [int(1..n_bots)] of int(1..map_size)

such that
    bots=g_n_bots,
    n_shelves_across=g_n_shelves_across, n_shelves_down=g_n_shelves_down,
    allDiff(bot_start),
    allDiff(bot_end),
    
    forAll bot : int(1..n_bots) .
    	$ Not in edge buffer start location
		$ Not in upper or lower bound 
    	world_border < (bot_start[bot] / X) + 1 /\
	(bot_start[bot] / X) + 1 <= X - world_border /\
		$ Not in left or right bound
	world_border < (bot_start[bot] % X) + 1 /\
	(bot_start[bot] % X) + 1 <= Y - world_border /\
	
	$ Not in edge buffer end location
		$ Not in upper or lower bound 
    	world_border < (bot_end[bot] / X) + 1 /\
	(bot_end[bot] / X) + 1 <= X - world_border /\
		$ Not in left or right bound
	world_border < (bot_end[bot] % X) + 1 /\
	(bot_end[bot] % X) + 1 <= Y - world_border /\
	
	$ check to see if bot is in shelf
	(bot_start[bot] / X) + 1 - (world_border) % (shelf_w + corridor_size) > shelf_w /\
	(bot_start[bot] % X) + 1 - (world_border) % (shelf_l + corridor_size) > shelf_l /\
	(bot_end[bot] / X) + 1 - (world_border) % (shelf_w + corridor_size) > shelf_w /\
	(bot_end[bot] % X) + 1 - (world_border) % (shelf_l + corridor_size) > shelf_l
