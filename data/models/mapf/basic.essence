given n_bots: int(1..10)

given g_shelf_y: int(1..10)
given g_shelf_x: int(1..20)

given g_space_btwn_shelf_x: int(1..10)
given g_space_btwn_shelf_y: int(1..10)

given g_n_shelves_across: int(1..50)
given g_n_shelves_down: int(1..50)

given g_x_edge_size: int(1..50)
given g_y_edge_size: int(1..20)

letting X be (g_n_shelves_across * g_shelf_x + (g_x_edge_size * 2)) $ issue of not adding space btwn shelves
letting Y be (g_n_shelves_down * g_shelf_y + (g_y_edge_size * 2)) 

letting map_size be X * Y

letting row_id be map_size / X
letting column_id be map_size % X

find bots: int(1..200)

find shelf_y: int(1..10)
find shelf_x: int(1..20)

find space_btwn_shelf_x: int(1..10)
find space_btwn_shelf_y: int(1..10)

find n_shelves_across: int(1..50)
find n_shelves_down: int(1..50)

find x_edge_size: int(1..50)
find y_edge_size: int(1..20)

find bot_start: matrix indexed by [int(1..n_bots)] of int(1..map_size)
find bot_end: matrix indexed by [int(1..n_bots)] of int(1..map_size)

such that
    bots=n_bots,
    shelf_y=g_shelf_y, shelf_x=g_shelf_x,
    space_btwn_shelf_x=g_space_btwn_shelf_x, space_btwn_shelf_y=g_space_btwn_shelf_y,
    n_shelves_across=g_n_shelves_across, n_shelves_down=g_n_shelves_down,
    x_edge_size=g_x_edge_size, y_edge_size=g_y_edge_size,
    allDiff(bot_start),
    allDiff(bot_end),
    
    forAll bot : int(1..n_bots) .
    	$ Not in edge buffer start location
		$ Not in upper or lower bound 
    	g_y_edge_size < (bot_start[bot] / X) + 1 /\
	(bot_start[bot] / X) + 1 <= X - g_y_edge_size /\
		$ Not in left or right bound
	g_x_edge_size < (bot_start[bot] % X) + 1 /\
	(bot_start[bot] % X) + 1 <= Y - g_x_edge_size /\
	
	$ Not in edge buffer end location
		$ Not in upper or lower bound 
    	g_y_edge_size < (bot_end[bot] / X) + 1 /\
	(bot_end[bot] / X) + 1 <= X - g_y_edge_size /\
		$ Not in left or right bound
	g_x_edge_size < (bot_end[bot] % X) + 1 /\
	(bot_end[bot] % X) + 1 <= Y - g_x_edge_size /\
	
	$ check to see if bot is in shelf
	(bot_start[bot] / X) + 1 - (g_y_edge_size) % (g_shelf_y + g_space_btwn_shelf_y) > g_shelf_y /\
	(bot_start[bot] % X) + 1 - (g_x_edge_size) % (g_shelf_x + g_space_btwn_shelf_x) > g_shelf_x /\
	(bot_end[bot] / X) + 1 - (g_y_edge_size) % (g_shelf_y + g_space_btwn_shelf_y) > g_shelf_y /\
	(bot_end[bot] % X) + 1 - (g_x_edge_size) % (g_shelf_x + g_space_btwn_shelf_x) > g_shelf_x
